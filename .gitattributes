# Normalize all text files to LF in the working tree so Prettier's default
# endOfLine=lf matches on every platform, regardless of core.autocrlf.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff2 binary
