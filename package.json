{
  "name": "kyneloom",
  "private": true,
  "version": "0.0.0",
  "description": "Kyneloom \u2014 the evidence-native experience engine for interactive sports. Repository foundation (KYN-01).",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.18.0 <25",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @kyneloom/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @kyneloom/web start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "node scripts/check-docs.mjs",
    "fixture:generate": "tsx scripts/generate-fixture.ts",
    "replay:golden": "tsx scripts/replay-golden.ts",
    "qa:visual": "tsx scripts/visual-qa.ts",
    "qa:record": "tsx scripts/record-replay.ts",
    "qa:record:live": "tsx scripts/record-replay-live.ts",
    "qa:record:camera": "tsx scripts/record-camera-live.ts",
    "qa:record:xray": "tsx scripts/record-xray-live.ts",
    "qa:record:landing": "tsx scripts/record-landing-live.ts",
    "moments:previews": "tsx scripts/generate-moment-previews.ts",
    "qa:record:gallery": "tsx scripts/record-gallery-live.ts",
    "moments:perf": "tsx scripts/measure-gallery-perf.ts",
    "qa:record:lens": "tsx scripts/record-lens-live.ts",
    "lens:perf": "tsx scripts/measure-lens-perf.ts",
    "intelligence:demo": "tsx scripts/intelligence-demo.ts",
    "intelligence:sensitivity": "tsx scripts/intelligence-sensitivity.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kyneloom/contracts": "workspace:*",
    "@kyneloom/match-core": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "eslint": "^10.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
