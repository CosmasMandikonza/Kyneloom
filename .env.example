# Kyneloom environment template — names and placeholders only, never secrets.
# Copy to apps/web/.env.local for the web app. Nothing here is required to
# run the foundation checks; every variable has a safe documented default.

# Optional absolute path to the test-harness fixtures directory consumed by
# the web app's fixture-loading seam. When unset, the app resolves
# <repository-root>/tests/fixtures by walking up from the working directory.
# See tests/fixtures/README.md for the fixture index format.
KYNELOOM_FIXTURES_DIR=
